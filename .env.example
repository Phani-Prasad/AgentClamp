# ─────────────────────────────────────────────────────────────────────────────
#  AgentClamp — Environment Configuration
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — zero config, data stored in Docker volume)
DATABASE_URL=sqlite:////app/data/agentclamp.db

# PostgreSQL (recommended for production / high load — uncomment to use)
# DATABASE_URL=postgresql://agentclamp:yourpassword@postgres:5432/agentclamp

# ── LLM API Keys (BYOK — Bring Your Own Key) ─────────────────────────────────
# Groq — Free tier, fast inference, recommended for getting started
# Get key at: https://console.groq.com
GROQ_API_KEY=

# OpenAI — Optional
OPENAI_API_KEY=

# Anthropic Claude — Optional
ANTHROPIC_API_KEY=

# Google Gemini — Optional
GOOGLE_API_KEY=

# Default provider & model used when agent doesn't specify
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

# ── RAG / Vector Store ────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=/app/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Frontend URLs (used at Docker build time) ─────────────────────────────────
# Change localhost to your server's hostname or IP for remote access
# e.g. NEXT_PUBLIC_API_URL=http://192.168.1.100  or  http://agentclamp.mycompany.com
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_WS_URL=ws://localhost

# ── Observability — LangFuse (optional) ──────────────────────────────────────
# Self-host LangFuse: docker run -p 3010:3000 langfuse/langfuse
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3010

# ── App Settings ──────────────────────────────────────────────────────────────
APP_NAME=AgentClamp Platform
DEBUG=false
