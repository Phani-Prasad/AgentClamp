# ── Database ───────────────────────────────────────────────────
# Local (SQLite - default, zero config)
DATABASE_URL=sqlite:///./agentclamp.db
# Cloud (PostgreSQL - uncomment for deployment)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentclamp

# ── LLM Providers ──────────────────────────────────────────────
# Groq — Free tier, recommended for local dev
# Get key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OpenAI — Optional, BYOK
OPENAI_API_KEY=

# Anthropic — Optional, BYOK
ANTHROPIC_API_KEY=

# Google — Optional, BYOK
GOOGLE_API_KEY=

# Default provider & model
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

# ── RAG ────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2   # Local, no API key needed

# ── Observability (LangFuse — optional) ────────────────────────
# Self-host: docker run -p 3000:3000 langfuse/langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=false

# ── App ────────────────────────────────────────────────────────
APP_NAME=AgentClamp Platform
DEBUG=true
CORS_ORIGINS=["http://localhost:3001"]
